{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conn-pilot.local/contracts/pipeline_composition.v1.json",
  "title": "CONN Pilot validated pipeline composition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "graph_fingerprint", "nodes"],
  "properties": {
    "schema_version": {"const": "conn_pilot_composition_v1"},
    "graph_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
